# Homelab live stats (server-only; never prefix with NEXT_PUBLIC_)
# Public HTTPS URL of the stats API on dreezy0 (Tailscale Funnel -> 127.0.0.1:8787)
HOMELAB_STATS_URL=https://dreezy0.tail0d1606.ts.net
# Bearer token from ~/homelab-stats/.env on dreezy0
HOMELAB_STATS_TOKEN=

# EmailJS (contact form). Browser-side by design, so NEXT_PUBLIC_ is required.
# Restrict the key to your domain in the EmailJS dashboard.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
